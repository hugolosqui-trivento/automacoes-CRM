DATABASE_URL=postgresql+psycopg://usuario:senha@host-pooler/banco?sslmode=require
ENVIRONMENT=development
LOG_LEVEL=INFO
NGROK_AUTHTOKEN=seu_token_ngrok
NGROK_URL=https://seu-dominio-reservado.ngrok-free.app

# O bind local evita expor portas diretamente na rede. Para liberar o dashboard
# em uma rede controlada, altere DASHBOARD_BIND_ADDRESS para 0.0.0.0.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8501

# Em um servidor, aponte para a imagem publicada no registry.
CRM_WEBHOOK_IMAGE=crm-webhook:local
